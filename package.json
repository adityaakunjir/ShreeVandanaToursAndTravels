{
  "name": "vandana-travels",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "validate": "npm run check && npm test && npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "catalogue:check": "node --experimental-strip-types scripts/check-catalogue.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "format": "prettier --write src tests package.json next.config.mjs tsconfig.json eslint.config.mjs tailwind.config.js postcss.config.js README.md",
    "skills:sync": "prisma skills sync",
    "postinstall": "prisma skills sync || exit 0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@sentropic/graphify": "^0.19.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prisma": "^8.0.0-rc.19",
    "shadcn": "^4.21.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3"
  }
}
